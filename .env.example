# Docker Compose reads .env automatically; Spring Boot run directly does not.
# Copy to ignored .env. Values are intentionally blank; fill required settings.
# Do not paste credentials into terminal output, screenshots, Git, or chat.

# [Required for self-hosting] Set docker,openai. Code default: docker (AI off).
SPRING_PROFILES_ACTIVE=
# [Required for self-hosting] Set slack-bot. Code default: no notifier.
NOTIFIER_TYPE=
# [Required with openai] Your own OpenAI API key; no default.
OPENAI_API_KEY=
# [Optional] Chat model. Compose default: gpt-4o-mini.
OPENAI_CHAT_MODEL=
# [Optional] Transcription model. Compose default: gpt-transcribe.
MEETODO_STT_MODEL=

# [Required for Slack operation] Set true. Default: false.
MEETODO_SLACK_BOT_ENABLED=
# [Required with slack-bot] Bot token / app-level connections:write token.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# [Required with slack-bot] Team C/G channel ID; invite the bot first.
SLACK_CHANNEL_ID=
# [Required for first administrator] Comma-separated Slack member IDs; no default.
MEETODO_ADMIN_SLACK_IDS=
# [Optional] CREATED-task assignee DMs. Set true to enable; default false.
MEETODO_SLACK_DM_ENABLED=

# [Required for Compose] Choose a strong PostgreSQL password; no default.
POSTGRES_PASSWORD=
# [Optional] Database/user names. Defaults: meetodo / meetodo.
POSTGRES_DB=
POSTGRES_USER=
# [Optional] Host ports bound to 127.0.0.1. Defaults: 8080 / 8081.
APP_PORT=
APP2_PORT=

# [Optional] Weekday 09:00 Asia/Seoul digest (no LLM). Default false.
MEETODO_DIGEST_ENABLED=
# [Optional] Spring cron; default: 0 0 9 * * MON-FRI.
MEETODO_DIGEST_CRON=
# [Optional] Docker dev digest endpoint. Default false; leave disabled normally.
MEETODO_DEV_ENDPOINTS_ENABLED=

# [Optional, alternate notifier modes only] slack / discord webhook transports.
# Not needed for slack-bot; the supplied app manifest omits incoming-webhook.
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
# [Optional, local samples only] Real Slack ID for the developer sample member.
# docker never seeds sample members. Default: development fake ID.
DEV_SLACK_USER_ID=
