# Example only. Spring Boot does not automatically load .env files.
# Set these in your shell or IDE; never commit real values.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
# Optional messenger notification: slack (webhook), discord, or slack-bot. local/docker (excluding test) can send; OpenAI is not required.
NOTIFIER_TYPE=
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# Weekday 09:00 Asia/Seoul digest (no LLM required).
MEETODO_DIGEST_ENABLED=false
MEETODO_DIGEST_CRON="0 0 9 * * MON-FRI"

# Docker Compose (local/test keep H2; only docker enables Flyway).
POSTGRES_DB=meetodo
POSTGRES_USER=meetodo
POSTGRES_PASSWORD=
APP_PORT=8080
APP2_PORT=8081
SPRING_PROFILES_ACTIVE=docker
# Development digest endpoint in docker; disabled unless explicitly enabled.
MEETODO_DEV_ENDPOINTS_ENABLED=false

# Optional Slack bot + Socket Mode. Keep disabled until tokens are configured.
MEETODO_SLACK_BOT_ENABLED=false
SLACK_APP_TOKEN=
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
DEV_SLACK_USER_ID=
